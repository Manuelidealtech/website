# Variabile SOLO server-side da aggiungere nelle Environment Variables di Vercel.
# Non usare mai il prefisso VITE_ per la service role key.
SUPABASE_SERVICE_ROLE_KEY=incolla_qui_la_service_role_key

# Facoltativa: il codice usa VITE_SUPABASE_URL come fallback.
SUPABASE_URL=https://tuo-progetto.supabase.co
